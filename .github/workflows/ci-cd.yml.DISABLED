name: 🚀 K8s GitOps Pipeline

on:
  push:
    branches: [ main ]
    paths:
      - 'stage-02-docker/app/**'
      - 'stage-03-kubernetes/manifests/app-deployment.yaml'

jobs:
  build-and-deploy:
    # 🎯 МАГИЯ ЗДЕСЬ: говорим GitHub использовать твой локальный компьютер!
    runs-on: self-hosted 
    
    steps:
      - name: 📥 Клонируем репозиторий
        uses: actions/checkout@v4

      - name: 🐳 Собираем новый Docker-образ с тегом commit SHA
        run: |
          cd stage-02-docker/app
          docker build -t devops-app:${{ github.sha }} .

      - name: 📦 Загружаем образ в локальный кластер kind
        run: |
          kind load docker-image devops-app:${{ github.sha }} --name devops-lab

      - name: 📝 Обновляем манифест Kubernetes новым тегом образа
        run: |
          sed -i "s|image: devops-app:.*|image: devops-app:${{ github.sha }}|g" stage-03-kubernetes/manifests/app-deployment.yaml

      - name: ☸️ Применяем манифесты к кластеру (Deploy!)
        run: |
          kubectl apply -f stage-03-kubernetes/manifests/app-deployment.yaml
          kubectl apply -f stage-03-kubernetes/manifests/app-service.yaml

      - name: ⏳ Ждём успешного Rolling Update
        run: |
          kubectl rollout status deployment/devops-app --timeout=60s
